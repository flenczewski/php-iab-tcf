#!/usr/bin/env php
<?php

declare(strict_types=1);

$ownCheckoutAutoload = __DIR__ . '/../vendor/autoload.php';
$autoloadCandidates = array_filter([
    // Set by Composer's vendor/bin proxy (Composer 2.2+); the only candidate
    // that is right for a project with a custom vendor-dir.
    is_string($GLOBALS['_composer_autoload_path'] ?? null) ? $GLOBALS['_composer_autoload_path'] : null,
    $ownCheckoutAutoload,                  // running from a checkout of this package
    __DIR__ . '/../../../autoload.php',    // installed as a dependency (vendor/flenczewski/php-iab-tcf/bin/iab-tcf)
]);

$loadedAutoload = null;
foreach ($autoloadCandidates as $candidate) {
    if (is_file($candidate)) {
        require $candidate;
        $loadedAutoload = $candidate;
        break;
    }
}

// Only a checkout of this package owns resources/vendor-list.json. Installed
// as a dependency, that file sits inside vendor/ and is not the caller's to
// rewrite, so update-gvl needs an explicit path there.
define('IAB_TCF_OWN_CHECKOUT', $loadedAutoload === $ownCheckoutAutoload);

if (!class_exists(Flenczewski\IabTcf\TcStringDecoder::class)) {
    fwrite(STDERR, "Could not locate the Composer autoloader. Run `composer install` first.\n");
    exit(1);
}

use Flenczewski\IabTcf\Exception\IabTcfException;
use Flenczewski\IabTcf\Gvl\Gvl;
use Flenczewski\IabTcf\Gvl\GvlFetcher;
use Flenczewski\IabTcf\TcStringDecoder;

function usage(): string
{
    return <<<TXT
    Usage:
      iab-tcf decode <tc-string>     Decode a TC String and print it as JSON.
      iab-tcf update-gvl [path]      Fetch the latest Global Vendor List and write the raw JSON to <path>
                                      (default, in a checkout of this package only: resources/vendor-list.json).

    TXT;
}

function runDecode(?string $tcString): int
{
    if ($tcString === null || $tcString === '') {
        fwrite(STDERR, "Error: missing TC String argument.\n\n" . usage());

        return 1;
    }

    try {
        $model = TcStringDecoder::decode($tcString);
    } catch (IabTcfException $e) {
        fwrite(STDERR, "Error: {$e->getMessage()}\n");

        return 1;
    }

    echo json_encode($model, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_THROW_ON_ERROR) . "\n";

    return 0;
}

/**
 * Writes beside the target, then renames over it: rename() within one
 * directory is atomic, so an interrupted run leaves the old list intact
 * instead of a truncated file that the next Gvl::bundled() fails to parse.
 */
function writeAtomically(string $target, string $contents): bool
{
    // Write through a symlink to the file it points at, as a plain write
    // would, rather than replacing the link itself with a regular file.
    $path = is_link($target) ? (realpath($target) ?: $target) : $target;
    $directory = dirname($path);

    // tempnam() creates the file exclusively under an unpredictable name, so
    // nothing planted beside the target (a symlink, say) can be written through.
    $temporary = @tempnam($directory, basename($path) . '.');
    if ($temporary === false) {
        return false;
    }
    // tempnam() falls back to the system temp dir when $directory is not
    // writable, and a rename() from there would not be atomic.
    if (dirname($temporary) !== (realpath($directory) ?: $directory)) {
        @unlink($temporary);

        return false;
    }

    // tempnam() creates the file 0600; keep the target's mode, or give a new
    // file the mode a plain write would have.
    $mode = is_file($path) ? fileperms($path) & 0777 : 0666 & ~umask();
    if (
        @file_put_contents($temporary, $contents) !== strlen($contents)
        || !@chmod($temporary, $mode)
        || !@rename($temporary, $path)
    ) {
        @unlink($temporary);

        return false;
    }

    return true;
}

function runUpdateGvl(?string $targetPath): int
{
    if ($targetPath === null && !IAB_TCF_OWN_CHECKOUT) {
        fwrite(STDERR, "Error: update-gvl needs an output path when this package is installed as a dependency.\n\n"
            . usage());

        return 1;
    }
    $target = $targetPath ?? dirname(__DIR__) . '/resources/vendor-list.json';

    try {
        $json = (new GvlFetcher())->fetchLatestRaw();

        // Parse through Gvl so a 200 response carrying an HTML error page, or
        // any other payload that is not a vendor list, is rejected here rather
        // than being written to disk and surfacing as an uncaught JsonException.
        Gvl::fromJson($json);

        // Re-encode (rather than writing the raw response verbatim) so the file
        // has stable, diff-friendly formatting regardless of how the server sent it.
        $decoded = json_decode($json, true, flags: JSON_THROW_ON_ERROR);
        $formatted = json_encode(
            $decoded,
            JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE | JSON_THROW_ON_ERROR,
        ) . "\n";
    } catch (IabTcfException | JsonException $e) {
        fwrite(STDERR, "Error fetching the Global Vendor List: {$e->getMessage()}\n");

        return 1;
    }

    if (!writeAtomically($target, $formatted)) {
        fwrite(STDERR, "Error: could not write to {$target}.\n");

        return 1;
    }

    $version = is_array($decoded) && isset($decoded['vendorListVersion'])
        ? $decoded['vendorListVersion']
        : 'unknown';
    fwrite(STDOUT, 'Wrote ' . strlen($formatted) . " bytes to {$target} (vendorListVersion={$version}).\n");

    return 0;
}

$command = $argv[1] ?? null;

exit(match ($command) {
    'decode' => runDecode($argv[2] ?? null),
    'update-gvl' => runUpdateGvl($argv[2] ?? null),
    'help', '--help', '-h' => (function (): int {
        fwrite(STDOUT, usage());

        return 0;
    })(),
    default => (function (): int {
        fwrite(STDERR, usage());

        return 1;
    })(),
});
